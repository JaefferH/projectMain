{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,

    "types": ["node"],

    "noEmitOnError": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./src",

    "paths": {
      "@config/*": ["config/*"],
      "@shared/*": ["shared/*"],
      "@modules/*": ["modules/*"],
      "@middleware/*": ["middleware/*"],
      "@types/*": ["types/*"],
      "@prisma/*": ["prisma/*"]
    }
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}